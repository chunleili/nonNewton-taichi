index a23f91e..1220615 100644
--- a/SPlisHSPlasH/My/Viscosity_Casson/Viscosity_Casson.cpp
+++ b/SPlisHSPlasH/My/Viscosity_Casson/Viscosity_Casson.cpp
@@ -311,7 +311,8 @@ void Viscosity_Casson::diagonalMatrixElement(const unsigned int i, Matrix3r &res
 		const Real density_j = model->getDensity(neighborIndex);
 		const Vector3r gradW = sim->gradW(xi - xj);
 		const Vector3r xixj = xi - xj;
-		result += d * mu * (model->getMass(neighborIndex) / density_j) / (xixj.squaredNorm() + 0.01*h2) * (gradW * xixj.transpose());
+		// Match the non-Newton coefficient used by matrixVecProd.
+		result += d * mu * visco->m_viscosity_nonNewton[neighborIndex] * (model->getMass(neighborIndex) / density_j) / (xixj.squaredNorm() + 0.01*h2) * (gradW * xixj.transpose());
 	);
 
 	// MYADD: 删掉boundary部分
@@ -416,6 +417,9 @@ void Viscosity_Casson::diagonalMatrixElement(const unsigned int i, Matrix3r &res
 #else
 // MYADD: 删掉非blockdiagonal部分
 #endif
+	// The matrix is I - dt/rho_i * L, not L. Omitting this identity
+	// makes isolated-particle blocks singular and breaks the CG solve.
+	result = Matrix3r::Identity() - (dt / density_i) * result;
 }
 
 
